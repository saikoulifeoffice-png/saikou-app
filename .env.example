# =============================================================================
# 買取SAIKOU Manager 環境変数
#  - このファイルをコピーして .env.local を作成してください（.env.local はコミットしない）
#  - NEXT_PUBLIC_ で始まる値のみブラウザに公開されます
# =============================================================================

# Supabase（ローカル開発時は `npx supabase status` の API_URL / ANON_KEY）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用: 従業員アカウント作成（Auth 管理 API）にのみ使用。絶対に NEXT_PUBLIC_ を付けない
SUPABASE_SERVICE_ROLE_KEY=

# サーバー専用: 顧客本人確認情報の暗号化鍵（AES-256-GCM, 32バイトを base64 で）
#   生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   鍵をローテーションする場合は IDENTITY_ENCRYPTION_KEYS に「版番号:鍵」をカンマ区切りで並べ、
#   IDENTITY_ENCRYPTION_KEY_VERSION を新しい版番号にする
IDENTITY_ENCRYPTION_KEYS=1:
IDENTITY_ENCRYPTION_KEY_VERSION=1

# アプリの公開URL（招待メールのリダイレクト先）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
